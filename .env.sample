# Copy to .env (gitignored), set FEATURE_WORKSPACE_ID, then invoke
# /swap-to-feature. It prepares the new target and applies the local swap.
# For a different workspace, do not carry over old feature connection IDs.
# The standalone preparation command (advanced) is:
#   python scripts/prepare_fabric_workspace.py --feature --use-azure-cli
# This explicitly provisions/reuses Workspace Identity feature connections.
# Existing valid feature connection IDs are preserved. No tracked source is
# changed until the normal workspace_swap.py command runs.
#
# Find these in Fabric:
#   - Workspace ID: open the workspace, gear icon (Workspace settings),
#     "About" -> "Workspace ID".
#   - Lakehouse ID: open the lakehouse item, copy the GUID from the URL
#     (the segment after /lakehouses/), or from the lakehouse details pane.
#
# These values are per-developer and per-feature-branch. workspace_swap.py
# reads this file on every swap-to-feature; --swap-to-dev never reads it.

FEATURE_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FEATURE_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000

# Pipeline bindings. Discovered by preparation; required by the offline swap
# only while the repo has a DataPipeline with a
# native semantic model refresh activity (Patterns_Load_Validate_And_Refresh).
# swap-to-feature stops with an error when any of these is missing, all zeros,
# repeated, or still a committed baseline. All three are your feature
# workspace's own values:
#   - Semantic model ID: open the model in the feature workspace and copy the
#     GUID from its URL (the segment after /datasets/ or /semanticmodels/).
#   - Connection IDs: Manage connections and gateways -> the connection ->
#     Settings. The notebook connection and the semantic model refresh
#     connection are two different connections; for an unattended run use
#     Workspace identity connections created for the feature workspace.
#
# /swap-to-dev handles first-time preparation of data/fabric-dev-bindings.json,
# then restores references. Subsequent returns to Dev stay offline.
# Local API calls use Azure CLI device-code sign-in when needed; default SPN
# runtime credentials and Actions connection-management access remain required.
# No second preparation skill or manual readiness skill is needed.

FEATURE_SEMANTIC_MODEL_ID=00000000-0000-0000-0000-000000000000
FEATURE_NOTEBOOK_CONNECTION_ID=00000000-0000-0000-0000-000000000000
FEATURE_REFRESH_CONNECTION_ID=00000000-0000-0000-0000-000000000000
