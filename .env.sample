# Local, non-secret ID inputs only. Copy to .env (gitignored).
# Never place Azure SP secrets or the GitHub PAT here.
#
# Facilitator: create each workspace WI and grant its resource access. Run
# Provision Fabric Connections explicitly to create its two WI connections,
# grant the admin group Owner, and save the GitHub Environment variables.
#
# Dev setup/cutover: copy the provisioned Dev GUIDs below, set the Variable
# Library's Dev baseline, and run:
#   python scripts/prepare_fabric_workspace.py --dev --replace-dev-bindings
# Review generated pipeline/parameter changes before committing. Ordinary
# swap-to-dev reads the committed rules and does not need these local keys.

DEV_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
DEV_SEMANTIC_MODEL_ID=00000000-0000-0000-0000-000000000000
DEV_NOTEBOOK_CONNECTION_ID=00000000-0000-0000-0000-000000000000
DEV_REFRESH_CONNECTION_ID=00000000-0000-0000-0000-000000000000

# Participant: for each Branch Out workspace, manually create WI and its
# Notebook/SemanticModelRefresh connections, grant WI Contributor, and supply
# both connection IDs. Do not carry over another workspace's connection IDs.
# Settings -> Manage connections and gateways -> connection -> Settings shows
# each GUID. Names follow Patterns-Feature-<Purpose>-<full workspace GUID>.
# /swap-to-feature can then validate connections and discover Lakehouse/model
# IDs through Azure user device-code sign-in; it never provisions resources.
# Existing complete feature IDs allow the ordinary swap to remain offline.

FEATURE_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FEATURE_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000
FEATURE_SEMANTIC_MODEL_ID=00000000-0000-0000-0000-000000000000
FEATURE_NOTEBOOK_CONNECTION_ID=00000000-0000-0000-0000-000000000000
FEATURE_REFRESH_CONNECTION_ID=00000000-0000-0000-0000-000000000000
